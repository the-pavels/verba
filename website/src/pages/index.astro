---
import Layout from "../layouts/Layout.astro";

const downloadUrl = "https://github.com/the-pavels/verba/releases/latest";
const repositoryUrl = "https://github.com/the-pavels/verba";
---

<Layout
  title="Verba: Translate and proofread anywhere on your Mac"
  description="Select text in any Mac app, press a shortcut, and review the translation or corrections beside your selection. Copy the result and carry on."
  path="/"
>
  <header class="site-header">
    <div class="shell nav-shell">
      <a class="brand" href="/" aria-label="Verba home">
        <img src="/images/verba-icon.png" alt="" width="36" height="36" />
        <span>Verba</span>
      </a>

      <nav class="nav-links" aria-label="Main navigation">
        <a href="#how-it-works">How it works</a>
        <a href="#features">Tools</a>
        <a href="#privacy">Privacy</a>
      </nav>

      <a class="button button-small button-dark" href={downloadUrl}>
        Download
        <span aria-hidden="true">↘</span>
      </a>
    </div>
  </header>

  <main>
    <section class="hero section">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <h1>
            Translate and proofread text{" "}
            <span class="hero-emphasis">anywhere on your Mac.</span>
          </h1>
          <p class="hero-lede">
            Select text in any app, press a shortcut, and Verba appears beside
            it. Review the result and copy it.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href={downloadUrl}>
              <span class="download-arrow" aria-hidden="true">↓</span>
              Download for Mac
            </a>
            <a class="text-link" href="#how-it-works">
              Try the workflow
              <span aria-hidden="true">↓</span>
            </a>
          </div>
          <p class="requirements">
            macOS 15 or later <span>•</span> Apple silicon
          </p>
        </div>

        <figure class="workflow-demo" id="how-it-works">
          <ol class="workflow-sequence" aria-label="Try the translation workflow">
            <li>
              <button class="demo-step" type="button" data-step="select" aria-pressed="false" aria-controls="workflow-scene" disabled>
                <span class="step-number" aria-hidden="true">01</span>
                Select text
              </button>
            </li>
            <li>
              <button class="demo-step" type="button" data-step="shortcut" aria-pressed="false" aria-controls="workflow-scene" disabled>
                <span class="step-number" aria-hidden="true">02</span>
                Press shortcut
              </button>
            </li>
            <li>
              <button class="demo-step" type="button" data-step="result" aria-pressed="true" aria-controls="workflow-scene" disabled>
                <span class="step-number" aria-hidden="true">03</span>
                Verba appears
              </button>
            </li>
            <li>
              <button class="demo-step" type="button" data-step="copy" aria-pressed="false" aria-controls="workflow-scene" disabled>
                <span class="step-number" aria-hidden="true">04</span>
                Copy result
              </button>
            </li>
          </ol>

          <div class="workflow-scene" id="workflow-scene" data-step="result" role="group" aria-label="Example translation in Mail" aria-describedby="demo-status">
            <div class="mail-window" aria-hidden="true">
              <div class="mail-toolbar">
                <div class="traffic-lights"><span></span><span></span><span></span></div>
                <span>Mail</span>
                <span class="mail-toolbar-mark">↩</span>
              </div>
              <div class="mail-message">
                <div class="mail-sender">
                  <span class="mail-avatar">A</span>
                  <div><strong>Anna</strong><span>To: you</span></div>
                  <span class="mail-time">9:41</span>
                </div>
                <p class="mail-subject">A quick question</p>
                <p class="mail-text"><mark>Guten Morgen! Können Sie mir bitte helfen?</mark></p>
                <p class="mail-signoff">Thanks,<br />Anna</p>
              </div>
            </div>

            <div class="demo-shortcut" hidden aria-hidden="true">
              <kbd>⌃</kbd><kbd>⌥</kbd><kbd>T</kbd>
              <span>Translate</span>
            </div>

            <img
              class="demo-result"
              src="/images/translation-light.png"
              alt="Verba beside the selected text, translating German into English with a Copy button"
              width="840"
              height="500"
              loading="eager"
              fetchpriority="high"
            />

            <div class="demo-copied" hidden aria-hidden="true">
              <span>✓</span> Copied. Ready to paste.
            </div>
          </div>

          <figcaption>
            <span>Workflow demo · Mail</span>
            <span id="demo-status" role="status" aria-live="polite" aria-atomic="true">Result ready to copy.</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="section utility">
      <div class="shell utility-layout">
        <div class="utility-copy">
          <h2>A good utility knows when to leave.</h2>
          <p>
            Copying closes the result window and returns you to your app.
            Press Escape or click elsewhere to dismiss it without copying.
          </p>
        </div>
        <div class="shortcut-reference" aria-label="Default shortcuts">
          <dl>
            <div><dt>Translate</dt><dd><kbd aria-hidden="true">⌃⌥T</kbd><span class="sr-only">Control Option T</span></dd></div>
            <div><dt>Proofread</dt><dd><kbd aria-hidden="true">⌃⌥P</kbd><span class="sr-only">Control Option P</span></dd></div>
          </dl>
          <p>Change either shortcut in Settings.</p>
        </div>
      </div>
    </section>

    <section class="section tools" id="features" aria-label="Translation and proofreading">
      <div class="shell">
        <article class="tool-row translation-row">
          <h2>Translate</h2>
          <div class="tool-description">
            <p>
              Translate with Apple’s built-in Translation framework. Set your
              target language once, then use it for each selection.
            </p>
            <p>No API key is needed for translation.</p>
          </div>
        </article>

        <article class="tool-row proofreading-row">
          <div class="tool-copy">
            <h2>Proofread</h2>
            <p>
              Fix spelling and grammar with your own OpenAI API key.
              Corrections are highlighted so you can review each change before copying.
            </p>
            <p class="tool-note">Requires an internet connection.</p>
          </div>
          <figure class="proofreading-visual">
            <img
              src="/images/proofreading-light.png"
              alt="Verba adds the missing word ‘is’ and a full stop, with both corrections highlighted"
              width="840"
              height="380"
              loading="lazy"
            />
            <figcaption>Corrections shown inline. Your original text stays untouched.</figcaption>
          </figure>
        </article>

        <aside class="setup-note" aria-labelledby="setup-heading">
          <h3 id="setup-heading">First launch</h3>
          <p>
            Move Verba to Applications and open it. The setup guide walks you
            through Accessibility permission and choosing a target language.
            You can enable proofreading by adding an OpenAI API key in Settings.
          </p>
        </aside>
      </div>
    </section>

    <section class="section privacy" id="privacy">
      <div class="shell privacy-panel">
        <h2>Your words aren’t our business.</h2>
        <div class="privacy-copy">
          <p>
            No accounts, analytics, advertising, text history, or cloud sync.
            Verba processes text only when you ask.
          </p>
          <p>
            Translation runs on your Mac. Proofreading sends your selection to
            OpenAI; your API key stays in macOS Keychain.
          </p>
          <a class="text-link text-link-light" href="/privacy/">
            Read the privacy details <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section final-cta" aria-labelledby="download-heading">
      <div class="shell download-row">
        <div class="download-copy">
          <img src="/images/verba-icon.png" alt="" width="56" height="56" loading="lazy" />
          <div>
            <h2 id="download-heading">Get Verba</h2>
            <p>Open source. macOS 15 or later. Apple silicon.</p>
          </div>
        </div>
        <a class="button button-primary" href={downloadUrl}>
          Download for Mac
          <span aria-hidden="true">↘</span>
        </a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <a class="brand brand-footer" href="/">
        <img src="/images/verba-icon.png" alt="" width="32" height="32" />
        <span>Verba</span>
      </a>
      <nav aria-label="Footer navigation">
        <a href={repositoryUrl}>GitHub</a>
        <a href={downloadUrl}>Releases</a>
        <a href="/privacy/">Privacy</a>
      </nav>
    </div>
  </footer>
</Layout>

<script>
  const scene = document.querySelector<HTMLElement>("#workflow-scene");
  const status = document.querySelector<HTMLElement>("#demo-status");
  const result = document.querySelector<HTMLImageElement>(".demo-result");
  const shortcut = document.querySelector<HTMLElement>(".demo-shortcut");
  const copied = document.querySelector<HTMLElement>(".demo-copied");
  const steps = document.querySelectorAll<HTMLButtonElement>(".demo-step");

  const descriptions = {
    select: "Select text in the app you’re using.",
    shortcut: "Press Control–Option–T to translate.",
    result: "Result ready to copy.",
    copy: "Result copied. Verba closes; Mail stays open.",
  };

  if (scene && status && result && shortcut && copied) {
    steps.forEach((button) => {
      button.disabled = false;
      button.addEventListener("click", () => {
        const step = button.dataset.step as keyof typeof descriptions;
        if (!Object.hasOwn(descriptions, step)) return;

        scene.dataset.step = step;
        result.hidden = step !== "result";
        shortcut.hidden = step !== "shortcut";
        copied.hidden = step !== "copy";
        status.textContent = descriptions[step];
        steps.forEach((other) => {
          other.setAttribute("aria-pressed", String(other === button));
        });
      });
    });
  }
</script>
