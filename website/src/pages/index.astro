---
import Layout from "../layouts/Layout.astro";

const downloadUrl = "https://github.com/the-pavels/verba/releases/latest";
const repositoryUrl = "https://github.com/the-pavels/verba";
---

<Layout
  title="Verba: Translate and proofread anywhere on your Mac"
  description="Translate and proofread selected text in any macOS app with one shortcut. Private by design, fast by nature, and always out of your way."
  path="/"
>
  <header class="site-header">
    <div class="shell nav-shell">
      <a class="brand" href="/" aria-label="Verba home">
        <img src="/images/verba-icon.png" alt="" width="36" height="36" />
        <span>Verba</span>
      </a>

      <nav class="nav-links" aria-label="Main navigation">
        <a href="#features">Features</a>
        <a href="#privacy">Privacy</a>
        <a href="#how-it-works">How it works</a>
      </nav>

      <a class="button button-small button-dark" href={downloadUrl}>
        Download
        <span aria-hidden="true">↘</span>
      </a>
    </div>
  </header>

  <main>
    <section class="hero section">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow reveal reveal-1">
            <span class="status-dot"></span>
            Made for macOS
          </p>
          <h1 class="reveal reveal-2">
            Better words,
            <span class="hero-emphasis">right where you are.</span>
          </h1>
          <p class="hero-lede reveal reveal-3">
            Translate and proofread selected text in any app without breaking
            your flow, opening another tab, or surrendering your privacy.
          </p>
          <div class="hero-actions reveal reveal-4">
            <a class="button button-primary" href={downloadUrl}>
              <span class="download-arrow" aria-hidden="true">↓</span>
              Download for Mac
            </a>
            <a class="text-link" href="#how-it-works">
              See how it works
              <span aria-hidden="true">↓</span>
            </a>
          </div>
          <p class="requirements reveal reveal-4">
            macOS 15 or later <span>•</span> Apple silicon
          </p>
        </div>

        <div class="hero-product reveal reveal-3" aria-label="Verba translating selected text">
          <div class="ambient-orb orb-one"></div>
          <div class="ambient-orb orb-two"></div>
          <div class="selection-card" aria-hidden="true">
            <span class="selection-app">Mail</span>
            <p>Guten Morgen! Können Sie mir bitte helfen?</p>
            <div class="selection-highlight"></div>
          </div>
          <div class="product-window">
            <div class="window-topbar" aria-hidden="true">
              <div class="traffic-lights"><span></span><span></span><span></span></div>
              <span class="window-label">Verba</span>
              <span class="window-shortcut">⌃⌥T</span>
            </div>
            <img
              src="/images/translation-light.png"
              alt="Verba translating a German sentence into English"
              width="840"
              height="500"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="shortcut-chip shortcut-translate" aria-hidden="true">
            <span>⌃</span><span>⌥</span><span>T</span>
          </div>
          <div class="cursor" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <section class="trust-strip" aria-label="Product principles">
      <div class="shell trust-grid">
        <p><span>01</span> Native macOS experience</p>
        <p><span>02</span> No accounts or analytics</p>
        <p><span>03</span> Your words stay yours</p>
      </div>
    </section>

    <section class="section workflow" id="how-it-works">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">One shortcut away</p>
          <h2>From selected to solved.</h2>
          <p>
            Verba lives quietly in your menu bar and appears only when you need it.
          </p>
        </div>

        <ol class="workflow-grid">
          <li class="workflow-step">
            <div class="step-topline">
              <span class="step-number">01</span>
              <span class="step-icon select-icon" aria-hidden="true">I</span>
            </div>
            <h3>Select</h3>
            <p>Highlight text in Mail, Notes, Safari, your editor, or almost any other app.</p>
            <div class="step-demo select-demo" aria-hidden="true">
              <span>Can you send the report today?</span>
              <i></i>
            </div>
          </li>

          <li class="workflow-step">
            <div class="step-topline">
              <span class="step-number">02</span>
              <span class="step-icon" aria-hidden="true">⌘</span>
            </div>
            <h3>Shortcut</h3>
            <p>Press your translation or proofreading shortcut. Both are fully customizable.</p>
            <div class="step-demo keys-demo" aria-hidden="true">
              <span>⌃</span><span>⌥</span><span>T</span>
              <small>Translate</small>
            </div>
          </li>

          <li class="workflow-step">
            <div class="step-topline">
              <span class="step-number">03</span>
              <span class="step-icon" aria-hidden="true">✓</span>
            </div>
            <h3>Copy</h3>
            <p>Review the result in a compact window, copy it, and carry on with your work.</p>
            <div class="step-demo result-demo" aria-hidden="true">
              <span class="result-check">✓</span>
              <span>Ready to paste</span>
              <span class="copy-chip">Copy</span>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="section features" id="features">
      <div class="shell">
        <div class="section-heading section-heading-split">
          <div>
            <p class="eyebrow">Two focused tools</p>
            <h2>Say exactly what you mean.</h2>
          </div>
          <p>
            One lightweight app for the two language tasks that interrupt your day most.
          </p>
        </div>

        <article class="feature-card feature-translate">
          <div class="feature-copy">
            <span class="feature-index">01 / Translate</span>
            <h3>Every language.<br />No context switch.</h3>
            <p>
              Translate selected text through Apple’s built-in Translation
              framework. Choose your target language once and keep moving.
            </p>
            <ul class="check-list">
              <li>Runs through Apple’s Translation framework</li>
              <li>Works across your favorite Mac apps</li>
              <li>Customizable global shortcut</li>
            </ul>
          </div>
          <div class="feature-visual">
            <div class="language-route" aria-hidden="true">
              <span>German</span><i></i><span>English</span>
            </div>
            <img
              src="/images/translation-light.png"
              alt="Verba translation result window"
              width="840"
              height="500"
              loading="lazy"
            />
          </div>
        </article>

        <article class="feature-card feature-proofread">
          <div class="feature-visual">
            <div class="proofread-note" aria-hidden="true">
              <span>2 corrections</span>
              <i></i>
            </div>
            <img
              src="/images/proofreading-light.png"
              alt="Verba proofreading result with corrections highlighted"
              width="840"
              height="380"
              loading="lazy"
            />
          </div>
          <div class="feature-copy">
            <span class="feature-index">02 / Proofread</span>
            <h3>Polished writing.<br />Still your voice.</h3>
            <p>
              Fix spelling and grammar with your own OpenAI API key. Verba
              highlights corrections so you can review every change.
            </p>
            <ul class="check-list">
              <li>Review corrections before copying</li>
              <li>Preserves tone, meaning, and formatting</li>
              <li>Your API key stays in macOS Keychain</li>
            </ul>
          </div>
        </article>
      </div>
    </section>

    <section class="section privacy" id="privacy">
      <div class="shell privacy-panel">
        <div class="privacy-copy">
          <p class="eyebrow eyebrow-light">Privacy is the architecture</p>
          <h2>Your words aren’t our business.</h2>
          <p>
            Verba has no accounts, no analytics, no advertising, no history,
            and no cloud synchronization. It processes only what you select,
            only when you ask.
          </p>
          <a class="text-link text-link-light" href="/privacy/">
            Read our plain-English privacy details <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="privacy-grid">
          <div class="privacy-stat">
            <strong>0</strong>
            <span>accounts</span>
          </div>
          <div class="privacy-stat">
            <strong>0</strong>
            <span>analytics events</span>
          </div>
          <div class="privacy-stat">
            <strong>0</strong>
            <span>text history</span>
          </div>
          <div class="privacy-stat privacy-stat-word">
            <strong>Yours</strong>
            <span>API key, secured in Keychain</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section details">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Designed to disappear</p>
          <h2>A good utility knows when to leave.</h2>
        </div>

        <div class="details-grid">
          <article>
            <span class="detail-mark" aria-hidden="true">⌖</span>
            <h3>Appears near your pointer</h3>
            <p>The result lands where your attention already is instead of in another window across the screen.</p>
          </article>
          <article>
            <span class="detail-mark" aria-hidden="true">⌨</span>
            <h3>Your shortcuts, your way</h3>
            <p>Keep the defaults or record key combinations that match your muscle memory.</p>
          </article>
          <article>
            <span class="detail-mark" aria-hidden="true">◌</span>
            <h3>No automatic replacement</h3>
            <p>Verba never edits your writing behind your back. Review first, then choose what to copy.</p>
          </article>
          <article>
            <span class="detail-mark" aria-hidden="true">◇</span>
            <h3>Native from menu bar to result</h3>
            <p>Built for macOS with familiar controls, system permissions, and a genuinely lightweight footprint.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section final-cta">
      <div class="shell cta-panel">
        <img src="/images/verba-icon.png" alt="" width="84" height="84" loading="lazy" />
        <p class="eyebrow">Stay in your flow</p>
        <h2>Write across languages.<br />Think in one place.</h2>
        <p>Verba is ready whenever your words need a little help.</p>
        <a class="button button-primary" href={downloadUrl}>
          Download for Mac
          <span aria-hidden="true">↘</span>
        </a>
        <span class="cta-requirements">Requires macOS 15+ and Apple silicon</span>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <a class="brand brand-footer" href="/">
        <img src="/images/verba-icon.png" alt="" width="32" height="32" />
        <span>Verba</span>
      </a>
      <p>Translate. Proofread. Carry on.</p>
      <nav aria-label="Footer navigation">
        <a href={repositoryUrl}>GitHub</a>
        <a href={downloadUrl}>Releases</a>
        <a href="/privacy/">Privacy</a>
      </nav>
    </div>
  </footer>
</Layout>
